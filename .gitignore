# --- rootless Podman (see flake.nix) ---------------------------------
# Per-machine container storage and the storage.conf generated for it on
# every shell entry. containers.conf / registries.conf / policy.json under
# .config/podman/ ARE tracked -- they're real project config.
/.containers/
.config/podman/storage.conf

# --- local environment ----------------------------------------------
.env

# --- node / frontend build output ------------------------------------
node_modules/
dist/
backend/generated/

# --- direnv -------------------------------------------------------
.direnv/

# --- nix --------------------------------------------------------
result
result-*

.claude
.vscode

# --- local k3s (see deployment/flake.nix) -----------------------------
deployment/.k3s/
# Cluster credentials -- never commit.
deployment/k3s.yaml

# --- helm dependency artifacts (see deployment/helm/*/Chart.yaml) -----
# Regeneratable via `helm dependency update`; Chart.lock IS tracked.
deployment/helm/*/charts/*.tgz